# DATABASE_URL: Connection string PostgreSQL fournie par Neon (Créer un projet -> connect).
# Exemple : postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-host.aws.neon.tech/neondb?sslmode=require"

# PIN du backoffice - remplace par un mot de passe fort en production
VITE_ADMIN_PIN=mina2026

# Lien commercial Wave de la boutique Mina's Food Mbour
# (aussi intégré en fallback dans le code, surchargeable ici)
VITE_WAVE_PAYMENT_LINK="https://pay.wave.com/m/M_sn_adltbIFU3xPE/c/sn/"

# Webhook Wave Business (optionnel mais conseillé) : secret partagé HMAC-SHA256
# utilisé pour authentifier les appels serveur-à-serveur de Wave vers /api/wave/webhook
# WAVE_WEBHOOK_SECRET=REMPLACE_PAR_UN_SECRET_LONG

# Notifications Push Web (PWA) - génère le couple de clés avec :
#   npx web-push generate-vapid-keys --json
# VAPID_PUBLIC_KEY et VAPID_PRIVATE_KEY restent côté serveur,
# VITE_VAPID_PUBLIC_KEY est exposée au navigateur pour la souscription.
# VAPID_SUBJECT est le contact (mailto:) exigé par le standard.
VAPID_PUBLIC_KEY=REMPLACE_PAR_TA_CLE_PUBLIQUE
VAPID_PRIVATE_KEY=REMPLACE_PAR_TA_CLE_PRIVEE
VITE_VAPID_PUBLIC_KEY=REMPLACE_PAR_TA_CLE_PUBLIQUE
VAPID_SUBJECT=mailto:commandes@minasfood-mbour.sn

# --------------------------------------------------------------------------
# DÉPLOIEMENT VERCEL (optionnel en local)
# --------------------------------------------------------------------------
# VERCEL=1 est défini automatiquement par Vercel à l'exécution des fonctions
# (pas besoin de le mettre ici). En local, pour simuler le mode serverless :
# VERCEL=1 PORT=3001 node dist/server.cjs
# Pour déployer, configure ces variables dans le dashboard Vercel :
#   DATABASE_URL (Neon), ADMIN_PIN, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY,
#   VAPID_SUBJECT, VITE_ADMIN_PIN, VITE_VAPID_PUBLIC_KEY,
#   VITE_WAVE_PAYMENT_LINK (optionnel), WAVE_WEBHOOK_SECRET (optionnel)